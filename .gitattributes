# 统一换行符为 LF：Windows 下编辑的文件若带 CRLF，
# 会导致 Dockerfile 的续行（\）与 shell 脚本在 Linux 构建时失败
* text=auto eol=lf

*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
Dockerfile      text eol=lf
.gitignore      text eol=lf
.dockerignore   text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.db  binary
